# =============================================================================
# PE Org-AI-R Platform Configuration
# =============================================================================

# --- Application Settings ---
APP_ENV=development  # Options: development, staging, production
DEBUG=false
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=console  # Options: console, json

# --- Snowflake Database Configuration ---
SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_ACCOUNT=your_account.region
SNOWFLAKE_DATABASE=PE_ORGAIR
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_ROLE=PE_ORGAIR_ROLE  # Optional

# --- Redis Cache Configuration ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=  # Optional
REDIS_PASSWORD=  # Optional
REDIS_DB=0
REDIS_TTL=3600  # Cache TTL in seconds (1 hour)

# --- AWS S3 Configuration ---
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket-name

# --- API Settings ---
API_RATE_LIMIT=100  # Requests per minute
MAX_PAGE_SIZE=100  # Maximum items per page